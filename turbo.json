{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["ml/dist/**"]
    },
    "make": {
      "dependsOn": ["build"],
      "inputs": ["ml/dist/**"],
      "outputs": ["app/out/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
